<Page x:Class="Overclutch.App.Views.AdvancedPage"
      ScrollViewer.CanContentScroll="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:Overclutch.App.Views"
      Title="Avancé">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="980">
            <TextBlock Text="Réglages avancés" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Des réglages débattus ou qui dépendent du matériel. Ils ne font jamais partie de l'optimisation en un clic." />
            <ui:InfoBar Title="À utiliser en connaissance de cause"
                        Message="Le gain est souvent faible et peut même être négatif selon ta config. Active-les un par un, teste en jeu, et reviens en arrière si ce n'est pas mieux."
                        Severity="Warning" IsOpen="True" IsClosable="False" />
            <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Left" Margin="0,12,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <views:TweakListView />
        </StackPanel>
    </ScrollViewer>
</Page>
