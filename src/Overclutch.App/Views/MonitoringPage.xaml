<Page x:Class="Overclutch.App.Views.MonitoringPage"
      ScrollViewer.CanContentScroll="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Monitoring">
    <Page.Resources>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="TileBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="4" />
        </Style>
        <SolidColorBrush x:Key="CpuBrush" Color="#7C4DFF" />
        <SolidColorBrush x:Key="GpuBrush" Color="#2EC4E6" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="980">
            <TextBlock Text="Monitoring" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Utilisation en direct, mise à jour chaque seconde. La température du processeur n'est pas affichée : la lire demande un pilote noyau, qu'Overclutch n'installe pas." />

            <UniformGrid Columns="3">
                <UniformGrid.Resources>
                    <!-- Tiles fill their cell so a row lines up even when one tile has an extra line. -->
                    <Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                    </Style>
                </UniformGrid.Resources>
                <ui:Card Margin="0,0,8,8" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Processeur" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource TileValue}" />
                        <ProgressBar Value="{Binding CpuPercent, Mode=OneWay}" Style="{StaticResource TileBar}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4,0,4,8" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Mémoire vive" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding RamText}" Style="{StaticResource TileValue}" />
                        <ProgressBar Value="{Binding RamPercent, Mode=OneWay}" Style="{StaticResource TileBar}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="8,0,0,8" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Carte graphique" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding GpuText}" Style="{StaticResource TileValue}" />
                        <ProgressBar Value="{Binding GpuPercent, Mode=OneWay}" Style="{StaticResource TileBar}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,8,8" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Température GPU" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding GpuTempText}" Style="{StaticResource TileValue}" />
                        <ProgressBar Value="{Binding GpuTempPercent, Mode=OneWay}" Style="{StaticResource TileBar}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4,0,4,8" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Mémoire vidéo" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding VramText}" Style="{StaticResource TileValue}" />
                        <ProgressBar Value="{Binding VramPercent, Mode=OneWay}" Style="{StaticResource TileBar}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="8,0,0,8" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Fréquence GPU" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding GpuClockText}" Style="{StaticResource TileValue}" />
                        <TextBlock Text="{Binding GpuName}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <ui:Card Margin="0,8,0,0" VerticalContentAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Dernière minute" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource CpuBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Processeur" Style="{StaticResource Caption}" Margin="6,0,16,0" VerticalAlignment="Center" />
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource GpuBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding HasGpu, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="Carte graphique" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding HasGpu, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                    <Border Height="180" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Viewbox Stretch="Fill">
                            <Canvas Width="600" Height="100" ClipToBounds="True">
                                <Line X1="0" X2="600" Y1="50" Y2="50" StrokeThickness="0.4" StrokeDashArray="4 4"
                                      Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <Polyline Points="{Binding GpuGraph}" Stroke="{StaticResource GpuBrush}" StrokeThickness="1.4"
                                          StrokeLineJoin="Round"
                                          Visibility="{Binding HasGpu, Converter={StaticResource BoolToVisibility}}" />
                                <Polyline Points="{Binding CpuGraph}" Stroke="{StaticResource CpuBrush}" StrokeThickness="1.4"
                                          StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="il y a 60 s" Style="{StaticResource Caption}" />
                        <TextBlock Text="maintenant" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
