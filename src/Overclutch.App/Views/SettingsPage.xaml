<Page x:Class="Overclutch.App.Views.SettingsPage"
      ScrollViewer.CanContentScroll="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Paramètres">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="980">
            <TextBlock Text="Paramètres" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Démarrage, mises à jour et données d'Overclutch." Style="{StaticResource PageSubtitle}" />

            <TextBlock Text="Démarrage" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <ui:CardControl Padding="16,12" Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Power24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Lancer avec Windows" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Démarre réduit dans la zone de notification, pour que le mode jeu soit toujours prêt. Sans invite UAC."
                                   Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding AutostartError}" Foreground="#FF8A80" Style="{StaticResource Caption}"
                                   Visibility="{Binding AutostartError, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}"
                                 IsEnabled="{Binding CanEditAutostart}" />
            </ui:CardControl>
            <ui:CardControl Padding="16,12" Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Dismiss24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Réduire dans la zone de notification à la fermeture" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="La croix cache la fenêtre au lieu de quitter. Pour quitter : clic droit sur l'icône, puis Quitter."
                                   Style="{StaticResource Caption}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding MinimizeToTray}" />
            </ui:CardControl>

            <TextBlock Text="Mises à jour" Style="{StaticResource SectionTitle}" />
            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold">
                            <Run Text="Overclutch" /> <Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"
                                         Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Rechercher" Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding CheckUpdatesCommand}" />
                        <ui:Button Content="Installer et redémarrer" Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Margin="8,0,0,0" Command="{Binding InstallUpdateCommand}"
                                   Visibility="{Binding AvailableVersion, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <TextBlock Text="Données" Style="{StaticResource SectionTitle}" />
            <ui:CardControl Padding="16,12">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Sauvegardes des réglages" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Les valeurs d'origine de chaque réglage modifié sont dans backups.json. Ne supprime pas ce fichier si tu veux pouvoir tout restaurer."
                                   Style="{StaticResource Caption}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Ouvrir le dossier" Command="{Binding OpenDataFolderCommand}" />
            </ui:CardControl>

            <TextBlock Text="À propos" Style="{StaticResource SectionTitle}" />
            <ui:Card>
                <StackPanel>
                    <TextBlock Text="Overclutch est gratuit et open source. Il n'utilise que des réglages Windows et NVIDIA documentés : rien n'est désactivé côté sécurité (Defender, Windows Update, protections du processeur)."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:HyperlinkButton Content="{Binding RepositoryUrl}" Command="{Binding OpenRepositoryCommand}"
                                        Padding="0" Margin="0,8,0,0" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
