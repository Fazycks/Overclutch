<Page x:Class="Overclutch.App.Views.HomePage"
      ScrollViewer.CanContentScroll="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Accueil">
    <Page.Resources>
        <Style x:Key="SpecLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,16,8" />
        </Style>
        <Style x:Key="SpecValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="980">
            <TextBlock Text="Accueil" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Optimise Windows pour le jeu en un clic, ou règle chaque point à la main." Style="{StaticResource PageSubtitle}" />

            <ui:InfoBar Title="Redémarrage nécessaire"
                        Message="Certains réglages modifiés ne prendront effet qu'après un redémarrage du PC."
                        Severity="Informational" IsClosable="True" Margin="0,0,0,12"
                        IsOpen="{Binding Services.RebootPending, Mode=OneWay}" />

            <!-- Score and the one-click actions -->
            <ui:Card Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Niveau d'optimisation" Style="{StaticResource Caption}" FontSize="13" />
                        <TextBlock FontSize="44" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                            <Run Text="{Binding Score, Mode=OneWay}" /><Run Text=" %" FontSize="24" />
                        </TextBlock>
                        <ProgressBar Value="{Binding Score, Mode=OneWay}" Maximum="100" Height="6" MaxWidth="360"
                                     HorizontalAlignment="Left" Width="360" Margin="0,4,0,8" />
                        <TextBlock Text="{Binding ScoreText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="220">
                        <ui:Button Content="Optimiser mon PC" Appearance="Primary" Icon="{ui:SymbolIcon Flash24}"
                                   HorizontalAlignment="Stretch" Padding="16,12" FontSize="15"
                                   Command="{Binding OptimizeCommand}" />
                        <ui:Button Content="Tout restaurer" Icon="{ui:SymbolIcon ArrowUndo24}"
                                   HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                   Command="{Binding RestoreAllCommand}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" />
                <TextBlock Text="{Binding BusyText}" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ui:InfoBar Margin="0,12,0,0" IsClosable="True"
                        Title="{Binding ResultTitle}" Message="{Binding ResultMessage}"
                        Severity="{Binding ResultSeverity}" IsOpen="{Binding HasResult, Mode=TwoWay}" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <ui:Card VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="20" Margin="0,0,8,0" />
                            <TextBlock Text="Ton PC" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Left"
                                         Visibility="{Binding Hardware, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                        <Grid DataContext="{Binding Hardware}"
                              Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Processeur" Style="{StaticResource SpecLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource SpecValue}">
                                <Run Text="{Binding Cpu, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CpuCores, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Row="1" Text="Carte graphique" Style="{StaticResource SpecLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Gpu}" Style="{StaticResource SpecValue}" />
                            <TextBlock Grid.Row="2" Text="Pilote" Style="{StaticResource SpecLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GpuDriver}" Style="{StaticResource SpecValue}" />
                            <TextBlock Grid.Row="3" Text="Mémoire" Style="{StaticResource SpecLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Ram}" Style="{StaticResource SpecValue}" />
                            <TextBlock Grid.Row="4" Text="Carte mère" Style="{StaticResource SpecLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Motherboard}" Style="{StaticResource SpecValue}" />
                            <TextBlock Grid.Row="5" Text="Système" Style="{StaticResource SpecLabel}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Os}" Style="{StaticResource SpecValue}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="2" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Broom24" FontSize="20" Margin="0,0,8,0" />
                            <TextBlock Text="Entretien rapide" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button Content="Nettoyer les fichiers temporaires" Icon="{ui:SymbolIcon Broom24}"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Command="{Binding CleanTempCommand}" />
                        <TextBlock Text="Vide les dossiers Temp de Windows et de ton compte." Style="{StaticResource Caption}" Margin="0,4,0,12" />
                        <ui:Button Content="Vider le cache DNS" Icon="{ui:SymbolIcon ArrowSync24}"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Command="{Binding FlushDnsCommand}" />
                        <TextBlock Text="Utile si un site ou un serveur de jeu ne répond plus après un changement d'adresse." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
