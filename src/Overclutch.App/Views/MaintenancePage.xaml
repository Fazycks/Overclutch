<Page x:Class="Overclutch.App.Views.MaintenancePage"
      ScrollViewer.CanContentScroll="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Overclutch.App.ViewModels"
      Title="Entretien">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="980">
            <TextBlock Text="Entretien" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Libère de l'espace et vide les caches. Coche les tâches à lancer ensemble ou à programmer." />

            <!-- Total of the checked tasks and the bulk actions -->
            <ui:Card Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Récupérable avec la sélection" Style="{StaticResource Caption}" FontSize="13" />
                        <TextBlock Text="{Binding TotalText}" FontSize="40" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding LastRunText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="220">
                        <ui:Button Content="Lancer la sélection" Appearance="Primary" Icon="{ui:SymbolIcon Broom24}"
                                   HorizontalAlignment="Stretch" Padding="16,12" FontSize="15"
                                   Command="{Binding RunSelectionCommand}" />
                        <ui:Button Content="Analyser" Icon="{ui:SymbolIcon ArrowSync24}"
                                   HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                   Command="{Binding AnalyzeCommand}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:InfoBar Margin="0,12,0,0" IsClosable="True"
                        Title="{Binding ResultTitle}" Message="{Binding ResultMessage}"
                        Severity="{Binding ResultSeverity}" IsOpen="{Binding HasResult, Mode=TwoWay}" />

            <ui:CardControl Margin="0,12,0,0" Padding="16,12" Icon="{ui:SymbolIcon CalendarClock24}">
                <ui:CardControl.Header>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Entretien automatique" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                                   Text="Lance les tâches cochées en arrière-plan, jamais pendant une partie. Overclutch doit être ouvert ou dans la zone de notification." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding ScheduleOptions}" SelectedIndex="{Binding ScheduleIndex}" MinWidth="170" />
            </ui:CardControl>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MaintenanceGroup}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,8">
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" Margin="0,0,8,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MaintenanceItemViewModel}">
                                        <ui:CardControl Margin="0,0,0,6" Padding="16,12">
                                            <ui:CardControl.Header>
                                                <Grid Margin="0,0,16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" Margin="0,0,12,0"
                                                              VerticalAlignment="Center"
                                                              ToolTip="Inclure dans la sélection et l'entretien automatique" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Warning, StringFormat='⚠ {0}'}"
                                                                   Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}"
                                                                   Style="{StaticResource Caption}" Foreground="#FFC56B" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Visibility="{Binding StatusText, Converter={StaticResource NullToVisibility}}"
                                                                   Style="{StaticResource Caption}" FontStyle="Italic" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </ui:CardControl.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SizeText}" MinWidth="70" TextAlignment="Right"
                                                           VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Grid Width="104">
                                                    <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22"
                                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:Button Content="Nettoyer" HorizontalAlignment="Stretch"
                                                               Command="{Binding RunCommand}"
                                                               Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}" />
                                                </Grid>
                                            </StackPanel>
                                        </ui:CardControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
