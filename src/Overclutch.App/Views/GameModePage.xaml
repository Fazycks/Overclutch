<Page x:Class="Overclutch.App.Views.GameModePage"
      ScrollViewer.CanContentScroll="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Mode jeu">
    <Page.Resources>
        <!-- A level is a card that lights up its border when picked -->
        <Style x:Key="LevelCard" TargetType="RadioButton">
            <Setter Property="GroupName" Value="GameModeLevel" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" CornerRadius="8" Padding="16,14" BorderThickness="2"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="980">
            <TextBlock Text="Mode jeu automatique" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Quand un jeu se lance, Overclutch lui laisse le plus de ressources possible. Tout revient comme avant à la fermeture du jeu." />

            <ui:CardControl Padding="16,14">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Games24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Activer le mode jeu" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Continue de fonctionner quand la fenêtre est réduite dans la zone de notification." Style="{StaticResource Caption}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Enabled}" />
            </ui:CardControl>

            <ui:Card Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Rocket24" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel>
                        <TextBlock Text="{Binding SessionTitle}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SessionDetail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <TextBlock Text="Niveau" Style="{StaticResource SectionTitle}" />
            <UniformGrid Columns="3">
                <RadioButton Style="{StaticResource LevelCard}" IsChecked="{Binding IsBalanced}" Margin="0,0,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Scales24" FontSize="20" Margin="0,0,8,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Équilibré" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="Priorité au jeu, plan d'alimentation performance et applis calmées. Le bon choix pour la plupart des PC." />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource LevelCard}" IsChecked="{Binding IsPerformance}" Margin="4,0,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="20" Margin="0,0,8,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Performance" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="Équilibré, plus la RAM en cache vidée au lancement et les mises à jour et l'indexation en pause." />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource LevelCard}" IsChecked="{Binding IsCustom}" Margin="4,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Options24" FontSize="20" Margin="0,0,8,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Personnalisé" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="Tu choisis chaque action ci-dessous. Elles sont gardées si tu changes de niveau puis reviens." />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <TextBlock Text="Pendant une partie" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,-4,0,8"
                       Text="Modifier une action passe en Personnalisé. Les changements s'appliquent à la prochaine partie." />
            <ui:CardControl Padding="16,12" Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Priorité haute pour le jeu" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Le processeur sert le jeu avant les autres applis. Certains anti-triche refusent : le jeu garde alors sa priorité." Style="{StaticResource Caption}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding RaisePriority}" />
            </ui:CardControl>
            <ui:CardControl Padding="16,12" Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Plan d'alimentation performance" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Bascule sur « Overclutch Performance » le temps de la partie, puis remet ton plan habituel." Style="{StaticResource Caption}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding BoostPowerPlan}" />
            </ui:CardControl>
            <ui:CardControl Padding="16,12" Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Calmer les applis en arrière-plan" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Passe les applis de la liste ci-dessous en priorité basse. Elles continuent de tourner normalement." Style="{StaticResource Caption}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding LowerBackgroundApps}" />
            </ui:CardControl>
            <ui:CardControl Padding="16,12" Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Vider la mémoire en attente au lancement" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Libère la RAM que Windows garde en cache pour que le jeu la trouve libre. Utile surtout avec 16 Go ou moins." Style="{StaticResource Caption}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding PurgeStandbyMemory}" />
            </ui:CardControl>
            <ui:CardControl Padding="16,12" Margin="0,0,0,6">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Mettre en pause les mises à jour et l'indexation" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Arrête Windows Update, ses téléchargements et l'indexation de la recherche pendant la partie, puis les relance." Style="{StaticResource Caption}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding PauseServices}" />
            </ui:CardControl>

            <TextBlock Text="Listes" Style="{StaticResource SectionTitle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Jeux en plus" FontWeight="SemiBold" />
                    <TextBlock Text="Exécutables à traiter comme des jeux même hors des bibliothèques connues. Un par ligne, par ex. « osu! » ou « javaw »."
                               Style="{StaticResource Caption}" Margin="0,2,0,6" />
                    <ui:TextBox Text="{Binding ExtraGamesText, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True" TextWrapping="NoWrap" Height="160"
                                VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                PlaceholderText="un exécutable par ligne" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Applis à calmer" FontWeight="SemiBold" />
                    <TextBlock Text="Exécutables mis en priorité basse pendant une partie. Un par ligne."
                               Style="{StaticResource Caption}" Margin="0,2,0,6" />
                    <ui:TextBox Text="{Binding BackgroundAppsText, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True" TextWrapping="NoWrap" Height="160"
                                VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Content="Enregistrer les listes" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"
                           Command="{Binding SaveListsCommand}" />
                <TextBlock Text="{Binding SavedText}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
