<Page x:Class="Overclutch.App.Views.ProfilesPage"
      ScrollViewer.CanContentScroll="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Overclutch.App.ViewModels"
      Title="Profils">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="980">
            <TextBlock Text="Profils" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Enregistre tes réglages et ton mode jeu pour les retrouver, ou échange-les avec un code. Un code ne contient que des noms de réglages, jamais d'infos sur ton PC." />

            <ui:Card Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Enregistrer ma configuration" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Les réglages actifs, le niveau du mode jeu et tes listes." Style="{StaticResource Caption}" Margin="0,2,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                    PlaceholderText="Nom du profil, par ex. Ranked" />
                        <ui:Button Grid.Column="1" Content="Enregistrer" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                                   Margin="8,0,0,0" MinWidth="130" VerticalAlignment="Stretch"
                                   Command="{Binding SaveCurrentCommand}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16,14" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Importer un code" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Le profil rejoint ta liste sans rien changer. Tu vois son contenu avant de l'appliquer." Style="{StaticResource Caption}" Margin="0,2,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding CodeText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Colle ici un code OC1-…" />
                        <ui:Button Grid.Column="1" Content="Importer" Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Margin="8,0,0,0" MinWidth="130" VerticalAlignment="Stretch"
                                   Command="{Binding ImportCommand}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:InfoBar Margin="0,12,0,0" IsClosable="True"
                        Title="{Binding ResultTitle}" Message="{Binding ResultMessage}"
                        Severity="{Binding ResultSeverity}" IsOpen="{Binding HasResult, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0" />
                <TextBlock Text="{Binding BusyText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Mes profils" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Aucun profil pour l'instant : enregistre ta configuration ou importe un code."
                       Style="{StaticResource Caption}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProfileItem}">
                        <ui:CardControl Padding="16,12" Margin="0,0,0,6" Icon="{ui:SymbolIcon Layer24}">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Appliquer" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                                           Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Content="Copier le code" Icon="{ui:SymbolIcon Copy24}" Margin="8,0,0,0"
                                           Command="{Binding DataContext.CopyCodeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="Supprimer" Margin="8,0,0,0"
                                           Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
